set(@PROJECT_NAMESPACE@_FOUND TRUE)

# Find available Component config files
file(GLOB __@PROJECT_NAMESPACE_UC@_AVAILABLE_COMPONENTS CONFIGURE_DEPENDS
    RELATIVE "${CMAKE_CURRENT_LIST_DIR}"
    "${CMAKE_CURRENT_LIST_DIR}/*/@PROJECT_NAMESPACE@*Config.cmake"
)

# Strip list to contain Component names only
list(TRANSFORM __@PROJECT_NAMESPACE_UC@_AVAILABLE_COMPONENTS REPLACE "/.*$" "")

# Report available Components
message(STATUS "[@PROJECT_NAME@] Available Components:")
foreach(component ${__@PROJECT_NAMESPACE_UC@_AVAILABLE_COMPONENTS})
    message(STATUS "- ${component}")
endforeach()

# Components were requested
if(@PROJECT_NAMESPACE@_FIND_COMPONENTS)
    message(STATUS "[@PROJECT_NAME@] Components were requested.")
    set(__@PROJECT_NAMESPACE_UC@_MISSING_REQUIRED_COMPONENTS "")

    # Check for and add each request
    foreach(req_component ${@PROJECT_NAMESPACE@_FIND_COMPONENTS})
        if(req_component IN_LIST __@PROJECT_NAMESPACE_UC@_AVAILABLE_COMPONENTS)
            message(STATUS "[@PROJECT_NAME@] Including matched component: ${req_component}.")
            set(@PROJECT_NAMESPACE@_${req_component}_FOUND True)
            set(req_component_config ${req_component}/@PROJECT_NAMESPACE@${req_component}Config.cmake)
            include("${CMAKE_CURRENT_LIST_DIR}/${req_component_config}")
        else()
            message(STATUS "[@PROJECT_NAME@] Unavailable component: ${req_component}")
            set(@PROJECT_NAMESPACE@_${req_component}_FOUND False)

            if(@PROJECT_NAMESPACE@_FIND_REQUIRED_${req_component})
                list(APPEND __@PROJECT_NAMESPACE_UC@_MISSING_REQUIRED_COMPONENTS ${req_component})
            endif()
        endif()
    endforeach()

    if(__@PROJECT_NAMESPACE_UC@_MISSING_REQUIRED_COMPONENTS)
        set(@PROJECT_NAMESPACE@_FOUND False)
        string(JOIN ", " __@PROJECT_NAMESPACE_UC@_MISSING_LIST ${__@PROJECT_NAMESPACE_UC@_MISSING_REQUIRED_COMPONENTS})
        set(@PROJECT_NAMESPACE@_NOT_FOUND_MESSAGE "Missing required component(s): ${__@PROJECT_NAMESPACE_UC@_MISSING_LIST}")
    endif()
else() # Components were not requested
    message(STATUS "[@PROJECT_NAME@] No components were requested. Importing all available.")

    # Add all components
    foreach(component ${__@PROJECT_NAMESPACE_UC@_AVAILABLE_COMPONENTS})
        message(STATUS "[@PROJECT_NAME@] Including available component: ${component}.")
        set(component_config ${component}/@PROJECT_NAMESPACE@${component}Config.cmake)
        include("${CMAKE_CURRENT_LIST_DIR}/${component_config}")
    endforeach()
endif()
